# ─────────────────────────────────────────────────────────────────────────────
# RagMind — Environment Variables
# Rename this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for web search fallback ─────────────────────────────────────────
# Get a free key at https://tavily.com  (1,000 searches/month on free tier)
TAVILY_API_KEY=

# ── LLM Models (Ollama) ───────────────────────────────────────────────────────
# Run `ollama pull <model>` before first use
GRADER_MODEL=qwen2.5:7b-instruct
GENERATOR_MODEL=qwen2.5:14b-instruct
EMBED_MODEL=intfloat/e5-base-v2

# ── Ollama server ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Retrieval tuning ─────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_DOCS=6
MIN_RELEVANT=1

# ── Pipeline behaviour ────────────────────────────────────────────────────────
MAX_RETRIES=3
MAX_HISTORY_TURNS=10

# ── Optional: LangSmith tracing ───────────────────────────────────────────────
# https://smith.langchain.com
LANGCHAIN_API_KEY=
